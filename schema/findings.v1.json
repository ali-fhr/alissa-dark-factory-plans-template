{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ali-fhr/alissa-plans/schema/findings.v1.json",
  "title": "alissa-plans findings frontmatter, version 1.4 (knowledge-base/<YYYY>/<MM>/<DD>/TASK-<n>/findings.md)",
  "description": "Widened in place from v1 (design alissa-build-discovery §2.3, §2.5, §4.6), so every alissa-findings/v1 file validates as written. v1.1 adds the URL cite beside the repo cite, bodyOfWork as the alternative to project (exactly one of the two), asker, and reads that may be empty. v1.2 (operator decision 2026-10-20) adds the evidence cite, naming a file of the finding's own evidence/ folder; a v1 or v1.1 file carries none. v1.3 (design alissa-security-review §5.1, lane SR-2) adds the optional `security` block on a question and the file-level `kind: security_review` that K14 requires beside it; a v1, v1.1 or v1.2 file carries neither. v1.4 (design alissa-documentation-check §5.1, lane DOC-3) adds the optional `doc` block on a question — a documentation passage's verdict against the code — and `kind: doc_check`, which K18 requires beside it; a question carries `security` or `doc`, never both (K15), and a file before v1.4 carries neither. The same v1.4 (design alissa-security-review §5.1, Studio issue #4754) widens the `security` block: `category` gains `abuse`, and `precondition` (none | self_serve | invited | privileged) names who can reach the effect — required on a `money`, `data` or `security` consequence, where it pins K10's row; a v1.3 file carries neither.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "reads", "topics", "questions"],
  "oneOf": [{ "required": ["project"], "properties": { "project": true } }, { "required": ["bodyOfWork"], "properties": { "bodyOfWork": true } }],
  "properties": {
    "schema": { "type": "string", "enum": ["alissa-findings/v1", "alissa-findings/v1.1", "alissa-findings/v1.2", "alissa-findings/v1.3", "alissa-findings/v1.4"] },
    "kind": {
      "description": "v1.3: a security review's finding says so, so the projection can gate it (K14, design alissa-security-review §8). v1.4: a documentation check's finding says `doc_check` (K18, design alissa-documentation-check §5.2).",
      "type": "string",
      "enum": ["security_review", "doc_check"]
    },
    "task": { "$ref": "#/definitions/taskRef" },
    "project": { "$ref": "#/definitions/convexId" },
    "bodyOfWork": { "$ref": "#/definitions/convexId" },
    "milestone": { "$ref": "#/definitions/convexId" },
    "asker": { "$ref": "#/definitions/taskRef" },
    "reads": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "sha"],
        "properties": { "repo": { "$ref": "#/definitions/repo" }, "sha": { "$ref": "#/definitions/gitSha" } }
      }
    },
    "topics": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } },
    "reverifies": { "$ref": "#/definitions/taskRef" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status", "confidence", "unblocks"],
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "text": { "$ref": "#/definitions/oneLine" },
          "status": { "type": "string", "enum": ["answered", "partial", "unanswerable"] },
          "confidence": { "$ref": "#/definitions/level" },
          "answer": { "type": "string" },
          "reason": { "type": "string" },
          "cites": { "type": "array", "maxItems": 24, "items": { "$ref": "#/definitions/cite" } },
          "security": { "$ref": "#/definitions/security" },
          "doc": { "$ref": "#/definitions/doc" },
          "unblocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["decision", "impact"],
              "properties": { "decision": { "$ref": "#/definitions/oneLine" }, "impact": { "$ref": "#/definitions/level" } }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "severity"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "severity": { "$ref": "#/definitions/level" },
          "cites": { "type": "array", "maxItems": 24, "items": { "$ref": "#/definitions/cite" } }
        }
      }
    },
    "suggestedTasks": {
      "description": "Proposals only, never materialized from here; the fields are the plan task schema's own (task-frontmatter.v1.json).",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "repo", "commitClass", "scope", "why"],
        "properties": {
          "title": { "type": "string", "minLength": 8, "maxLength": 200 },
          "repo": { "$ref": "#/definitions/repo" },
          "kind": { "type": "string", "enum": ["code", "design"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high", "top"] },
          "commitClass": {
            "type": "string",
            "enum": ["schema-migration", "auth-secrets", "pricing-billing", "customer-promise", "product-surface", "gate-verification", "drift-fix", "flaky-test", "exhaust-followup", "doc-correction"]
          },
          "scope": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[^\\s,]+$" } },
          "new": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[^\\s,*]+$" } },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema": { "not": { "enum": ["alissa-findings/v1.3", "alissa-findings/v1.4"] } } } },
      "then": {
        "description": "A file before alissa-findings/v1.3 carries no `security` block and no `kind`: those are v1.3's.",
        "properties": {
          "kind": false,
          "questions": { "items": { "properties": { "security": false } } }
        }
      }
    },
    {
      "if": { "properties": { "schema": { "not": { "const": "alissa-findings/v1.4" } } } },
      "then": {
        "description": "A file before alissa-findings/v1.4 carries no `doc` block and no `kind: doc_check`: those are v1.4's.",
        "properties": {
          "kind": { "not": { "const": "doc_check" } },
          "questions": { "items": { "properties": { "doc": false } } }
        }
      }
    },
    {
      "if": { "properties": { "schema": { "const": "alissa-findings/v1.3" } } },
      "then": {
        "description": "An alissa-findings/v1.3 `security` block carries no `precondition` and no `category: abuse`: those are v1.4's (Studio issue #4754).",
        "properties": {
          "questions": { "items": { "properties": { "security": { "properties": { "precondition": false, "category": { "not": { "const": "abuse" } } } } } } }
        }
      }
    },
    {
      "if": { "properties": { "schema": { "const": "alissa-findings/v1.4" } } },
      "then": {
        "description": "An alissa-findings/v1.4 `security` block with a `money`, `data` or `security` consequence names its `precondition`: who can reach the effect picks §5.1's row (K10).",
        "properties": {
          "questions": {
            "items": {
              "properties": {
                "security": {
                  "if": { "properties": { "consequence": { "enum": ["money", "data", "security"] } }, "required": ["consequence"] },
                  "then": { "properties": { "precondition": true }, "required": ["precondition"] }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "schema": { "const": "alissa-findings/v1.1" } } },
      "then": {
        "description": "An alissa-findings/v1.1 file carries no evidence cite: that is v1.2's.",
        "properties": {
          "questions": { "items": { "properties": { "cites": { "items": { "not": { "$ref": "#/definitions/evidenceCite" } } } } } },
          "risks": { "items": { "properties": { "cites": { "items": { "not": { "$ref": "#/definitions/evidenceCite" } } } } } }
        }
      }
    }
  ],
  "if": { "properties": { "schema": { "const": "alissa-findings/v1" } } },
  "then": {
    "description": "An alissa-findings/v1 file is read exactly as before v1.1: a project, at least one read, repo cites without a kind.",
    "required": ["project"],
    "properties": {
      "project": true,
      "bodyOfWork": false,
      "asker": false,
      "reads": { "minItems": 1 },
      "questions": { "items": { "properties": { "cites": { "items": { "$ref": "#/definitions/repoCiteV1" } } } } },
      "risks": { "items": { "properties": { "cites": { "items": { "$ref": "#/definitions/repoCiteV1" } } } } }
    }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "taskRef": { "type": "string", "pattern": "^TASK-[0-9]+$" },
    "convexId": { "type": "string", "pattern": "^[a-z0-9]{32}$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "level": { "type": "string", "enum": ["high", "medium", "low"] },
    "oneLine": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u2028\\u2029]+$" },
    "security": {
      "description": "v1.3 (design alissa-security-review §5.1): one security finding. `severity` is calibrated as consequence × reachability (§5.1's table, K10); `calibration` is the stated reason when it departs from the table by more than one step. v1.4 adds `precondition` (who can reach the effect: none, self_serve, invited, privileged) and the `abuse` category; a block naming its precondition takes its row's severity exactly or carries a `calibration` (K10). `key` is stable across runs (§4.2) and unique in the file (K11).",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "severity", "category", "consequence", "reachable", "scenario", "fix", "crossRun"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9.-]{1,80}$" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "category": { "type": "string", "enum": ["authz", "money", "injection", "storage", "secrets", "supply_chain", "container", "abuse"] },
        "consequence": {
          "type": "string",
          "enum": ["money", "data", "security", "correctness", "leak", "alarm", "stall", "contract", "cosmetic", "redundant-test", "hypothetical"]
        },
        "reachable": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "scenario": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "fix": { "type": "string", "minLength": 1, "maxLength": 800 },
        "crossRun": { "type": "string", "enum": ["new", "still_open", "fixed", "regressed"] },
        "cwe": { "type": "string", "pattern": "^CWE-[1-9][0-9]{0,5}$" },
        "calibration": { "$ref": "#/definitions/oneLine", "maxLength": 300 },
        "precondition": { "type": "string", "enum": ["none", "self_serve", "invited", "privileged"] }
      }
    },
    "doc": {
      "description": "v1.4 (design alissa-documentation-check §5.1): one documentation passage's verdict against the code at the pinned SHA. The code cites are the question's ordinary `cites`. `passage` is quoted verbatim from `docPath` at `docRepo`'s pinned SHA (K17) and is absent exactly when `verdict` is `missing`; a `right` verdict's `fixSide` is `doc`; an `answered` or `partial` question with a block carries at least one repo cite (K15). `key` is `<repo>.<doc-stem>.<subject>`, an identity across runs, unique in the file (K16).",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "verdict", "area", "docRepo", "docPath", "fixSide", "crossRun"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9.-]{1,80}$" },
        "verdict": { "type": "string", "enum": ["right", "wrong", "stale", "missing"] },
        "area": { "type": "string", "enum": ["readme", "docs", "agent", "api", "site"] },
        "docRepo": { "$ref": "#/definitions/repo" },
        "docPath": { "type": "string", "maxLength": 512, "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\r\\n]+$" },
        "anchor": { "$ref": "#/definitions/oneLine", "maxLength": 200 },
        "passage": { "type": "string", "minLength": 1, "maxLength": 600 },
        "correction": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fixSide": { "type": "string", "enum": ["doc", "code", "ask"] },
        "crossRun": { "type": "string", "enum": ["new", "newly_drifted", "still_wrong", "fixed"] }
      }
    },
    "httpsUrl": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$" },
    "cite": {
      "description": "A repo cite (`kind` absent or `repo`), in v1.1 a URL cite (§2.5), or in v1.2 an evidence cite.",
      "oneOf": [{ "$ref": "#/definitions/repoCite" }, { "$ref": "#/definitions/urlCite" }, { "$ref": "#/definitions/evidenceCite" }]
    },
    "evidenceCite": {
      "description": "v1.2: a file of the finding's own evidence/ folder, by its name (K9 holds the two to each other).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file"],
      "properties": {
        "kind": { "const": "evidence" },
        "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
      }
    },
    "urlCite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "retrievedAt", "quote"],
      "properties": {
        "kind": { "const": "url" },
        "url": { "$ref": "#/definitions/httpsUrl" },
        "retrievedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
        "quote": { "$ref": "#/definitions/oneLine", "minLength": 20, "maxLength": 300 },
        "archive": { "$ref": "#/definitions/httpsUrl" }
      }
    },
    "repoCite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "lines", "blob"],
      "properties": {
        "kind": { "const": "repo" },
        "repo": { "$ref": "#/definitions/repo" },
        "path": { "type": "string", "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\r\\n]+$" },
        "lines": { "type": "string", "pattern": "^[1-9][0-9]{0,6}(-[1-9][0-9]{0,6})?$" },
        "blob": { "$ref": "#/definitions/gitSha" }
      }
    },
    "repoCiteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "lines", "blob"],
      "properties": {
        "repo": { "$ref": "#/definitions/repo" },
        "path": { "type": "string", "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\r\\n]+$" },
        "lines": { "type": "string", "pattern": "^[1-9][0-9]{0,6}(-[1-9][0-9]{0,6})?$" },
        "blob": { "$ref": "#/definitions/gitSha" }
      }
    }
  }
}
