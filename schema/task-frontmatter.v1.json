{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ali-fhr/alissa-plans/schema/task-frontmatter.v1.json",
  "title": "alissa-plans task frontmatter, version 1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "priority", "dependsOn", "commitClass"],
  "properties": {
    "id": { "$ref": "#/definitions/slug" },
    "title": { "type": "string", "minLength": 8, "maxLength": 200 },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "milestone": { "$ref": "#/definitions/convexId" },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "top"] },
    "dependsOn": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": { "id": { "$ref": "#/definitions/slug" }, "type": { "$ref": "#/definitions/edgeType" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "type"],
            "properties": { "task": { "type": "string", "pattern": "^TASK-[0-9]+$" }, "type": { "$ref": "#/definitions/edgeType" } }
          }
        ]
      }
    },
    "scope": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[^\\s,]+$" } },
    "kind": { "type": "string", "enum": ["code", "design", "discovery"] },
    "new": {
      "description": "Scope paths that do not exist yet at the repository's default branch; every entry is also in scope (plan-lint rule 2).",
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^\\s,*]+$" }
    },
    "commitClass": {
      "type": "string",
      "enum": ["schema-migration", "auth-secrets", "pricing-billing", "customer-promise", "product-surface", "gate-verification", "drift-fix", "flaky-test", "exhaust-followup", "doc-correction"]
    },
    "sources": {
      "description": "Source keys (rule 9); a discovery task may instead name what its questions read, `code | web | both` (schema v1.3; absent reads as `code`).",
      "anyOf": [{ "$ref": "#/definitions/sourceKeys" }, { "$ref": "#/definitions/discoverySources" }]
    },
    "asker": {
      "description": "Discovery only (schema v1.3): the task a project-less ask came from; with it, `milestone` may be omitted (design alissa-build-discovery §4.6).",
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "questions": {
      "description": "Discovery only, and required there (schema v1.2): what the task asks, and the decisions each answer settles.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/definitions/question" }
    }
  },
  "if": { "required": ["kind"], "properties": { "kind": { "const": "discovery" } } },
  "then": {
    "description": "A discovery task names no scope (feed_plan derives it under knowledge-base/) and is always doc-correction.",
    "required": ["questions"],
    "properties": { "scope": false, "new": false, "questions": true, "commitClass": { "const": "doc-correction" } },
    "allOf": [
      { "if": { "required": ["sources"], "properties": { "sources": { "const": "web" } } }, "else": { "required": ["repo"], "properties": { "repo": true } } },
      { "if": { "required": ["asker"], "properties": { "asker": true } }, "else": { "required": ["milestone"], "properties": { "milestone": true } } }
    ]
  },
  "else": { "required": ["scope", "repo", "milestone"], "properties": { "scope": true, "repo": true, "milestone": true, "questions": false, "asker": false, "sources": { "$ref": "#/definitions/sourceKeys" } } },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$" },
    "convexId": { "type": "string", "pattern": "^[a-z0-9]{32}$" },
    "edgeType": { "type": "string", "enum": ["hard", "soft", "acceptance"] },
    "sourceKey": { "type": "string", "pattern": "^(gate|later|minor|esc|drift|stale):[^\\s]+$" },
    "sourceKeys": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/definitions/sourceKey" } },
    "discoverySources": { "type": "string", "enum": ["code", "web", "both"] },
    "oneLine": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u2028\\u2029]+$" },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "unblocks"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "text": { "$ref": "#/definitions/oneLine", "maxLength": 2000 },
        "unblocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "impact"],
            "properties": { "decision": { "$ref": "#/definitions/oneLine", "maxLength": 500 }, "impact": { "type": "string", "enum": ["high", "medium", "low"] } }
          }
        }
      }
    }
  }
}
