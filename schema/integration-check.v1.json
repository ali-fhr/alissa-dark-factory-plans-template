{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ali-fhr/alissa-plans/schema/integration-check.v1.json",
  "title": "alissa-plans integration-check report frontmatter, version 1 (integration-check/<YYYY>/<MM>/<DD>/<milestone>/report.md)",
  "description": "The IntegrationReport of design alissa-build-integration-check.md §3.4. The schema holds the shapes; plan-lint's I2–I9 hold the rules across fields (§3.5): a Couldn't verify item's `why` and `howToCheck` are I5's, a `notes` entry's variable-name shape is I8's, and `status` against statusOf (§4.1) is I6's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "check", "project", "milestone", "run", "previous", "notes", "reads", "recipe", "status", "couldntVerify", "steps", "criteria", "neighbours", "scope"],
  "properties": {
    "schema": { "const": "alissa-integration-check/v1" },
    "task": { "$ref": "#/definitions/taskRef" },
    "check": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "project": { "$ref": "#/definitions/convexId" },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "n", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/convexId" },
        "n": { "type": "integer", "minimum": 0 },
        "title": { "$ref": "#/definitions/oneLine" }
      }
    },
    "run": { "type": "integer", "minimum": 1 },
    "previous": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^integration-check/[0-9]{4}/[0-9]{2}/[0-9]{2}/[a-z0-9][a-z0-9-]*/report\\.md$" }
      ]
    },
    "notes": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
    "reads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "sha"],
        "properties": { "repo": { "$ref": "#/definitions/repo" }, "sha": { "$ref": "#/definitions/gitSha" } }
      }
    },
    "recipe": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "state", "path"],
        "properties": {
          "repo": { "$ref": "#/definitions/repo" },
          "state": { "type": "string", "enum": ["confirmed", "draft", "none"] },
          "path": { "$ref": "#/definitions/relPath" }
        }
      }
    },
    "status": { "type": "string", "enum": ["SUCCESS", "UNCERTAIN", "FAILED"] },
    "couldntVerify": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "what"],
        "properties": {
          "id": { "type": "string", "pattern": "^u[1-9][0-9]*$" },
          "kind": { "type": "string", "enum": ["provider_keys", "payments", "production_data", "devices", "inboxes", "app_start", "time", "other"] },
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string" },
          "howToCheck": { "type": "string" },
          "criterion": { "$ref": "#/definitions/criterionId" }
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "evidence", "detail"],
        "properties": {
          "id": { "type": "string", "enum": ["build", "tests", "start", "routes", "screens", "contracts"] },
          "verdict": { "$ref": "#/definitions/verdict" },
          "evidence": { "$ref": "#/definitions/evidence" },
          "detail": { "type": "string" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "evidence", "detail"],
        "properties": {
          "id": { "$ref": "#/definitions/criterionId" },
          "verdict": { "$ref": "#/definitions/verdict" },
          "evidence": { "$ref": "#/definitions/evidence" },
          "detail": { "type": "string" },
          "failure": { "$ref": "#/definitions/failure" },
          "unverified": { "type": "string", "pattern": "^u[1-9][0-9]*$" }
        }
      }
    },
    "neighbours": {
      "type": "array",
      "maxItems": 42,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "target", "verdict", "evidence", "detail"],
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "kind": { "type": "string", "enum": ["route", "screen"] },
          "target": { "$ref": "#/definitions/oneLine" },
          "verdict": { "$ref": "#/definitions/verdict" },
          "evidence": { "$ref": "#/definitions/evidence" },
          "detail": { "type": "string" },
          "failure": { "$ref": "#/definitions/failure" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prs", "paths", "oneHop", "contracts", "cut"],
      "properties": {
        "prs": { "$ref": "#/definitions/strings" },
        "paths": { "$ref": "#/definitions/strings" },
        "oneHop": { "$ref": "#/definitions/strings" },
        "contracts": { "$ref": "#/definitions/strings" },
        "cut": { "$ref": "#/definitions/strings" }
      }
    }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "criterionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
    "taskRef": { "type": "string", "pattern": "^TASK-[0-9]+$" },
    "convexId": { "type": "string", "pattern": "^[a-z0-9]{32}$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "oneLine": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u2028\\u2029]+$" },
    "relPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|$))[^\\r\\n]+$" },
    "strings": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1 } },
    "verdict": { "type": "string", "enum": ["pass", "fail", "unverified", "skipped"] },
    "evidence": { "type": "array", "maxItems": 60, "items": { "$ref": "#/definitions/relPath" } },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "suggestedFix", "paths"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "suggestedFix": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "maxItems": 24, "items": { "$ref": "#/definitions/relPath" } }
      }
    }
  }
}
